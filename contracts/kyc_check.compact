pragma language_version >= 0.22;

import CompactStandardLibrary;

export ledger prohibited_countries: Map<Bytes<32>, Boolean>;
export ledger issued_credentials: Map<Bytes<32>, Boolean>;
export ledger admin: Bytes<32>;

constructor(admin_pk: Bytes<32>) {
  admin = disclose(admin_pk);
}

witness localSecretKey(): Bytes<32>;
witness country(): Bytes<32>;
witness credentialSalt(): Bytes<32>;

export circuit issueCredential(commitment: Bytes<32>): [] {
  assert(disclose(publicKey(localSecretKey())) == admin, "Only admin can issue KYC credentials");
  issued_credentials.insert(disclose(commitment), true);
}

export circuit registerProhibitedCountry(country_hash: Bytes<32>): [] {
  assert(disclose(publicKey(localSecretKey())) == admin, "Only admin can register prohibited countries");
  prohibited_countries.insert(disclose(country_hash), true);
}

export circuit verifyKYC(): Boolean {
  const commitment = credentialCommitment(country(), credentialSalt());
  assert(issued_credentials.member(disclose(commitment)), "KYC credential was not issued by the administrator");
  assert(!prohibited_countries.member(disclose(country())), "User resides in a prohibited country");
  
  return disclose(true);
}

export circuit credentialCommitment(countryCode: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "kyc:credential:"),
    countryCode,
    salt
  ]);
}

export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "kyc:pk:"), sk]);
}
